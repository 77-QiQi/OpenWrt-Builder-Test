diff --git a/target/linux/ramips/files/drivers/mtd/nand/raw/mt7620_nand.c b/target/linux/ramips/files/drivers/mtd/nand/raw/mt7620_nand.c
new file mode 100644
index 0000000..f854d7a
--- /dev/null
+++ b/target/linux/ramips/files/drivers/mtd/nand/raw/mt7620_nand.c
@@ -0,0 +1,1108 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek MT7620 NAND Flash Controller driver
+ *
+ * The MT7620 NFC is a one-shot sequencer: a whole NAND operation is
+ * described by programming the command/address/configuration registers and
+ * then draining or filling the 32 bit data FIFO.  Unlike the MT7621
+ * controller there is no DMA engine and no automatic OOB formatter, and the
+ * ECC engine only computes three parity bytes per 512 byte sector.  Single
+ * bit errors therefore have to be located and corrected in software.
+ *
+ * The OOB layout, the ECC parity positions and the bad block marker
+ * positions are kept identical to the legacy Ralink driver so images written
+ * by the vendor bootloader (and UBI volumes created from them) stay
+ * readable.
+ */
+
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/errno.h>
+#include <linux/io.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/mtd/mtd.h>
+#include <linux/mtd/rawnand.h>
+#include <linux/mtd/mtk_bmt.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+/* NFC registers, relative to the controller base */
+#define NFC_CTRL			0x00
+#define   NFC_CTRL_WP			BIT(0)
+#define   NFC_CTRL_FLUSH		BIT(1)
+
+#define NFC_CONF			0x04
+#define   NFC_CONF_ECC			BIT(3)
+#define   NFC_CONF_GDMA			BIT(2)
+#define   NFC_CONF_ADDR_CYCLES_S	16
+#define   NFC_CONF_LEN_S		20
+
+#define NFC_CMD1			0x08
+#define NFC_CMD2			0x0c
+#define NFC_CMD3			0x10
+#define NFC_ADDR			0x14
+#define NFC_DATA			0x18
+#define NFC_STATUS			0x20
+#define   NFC_STATUS_BUSY		BIT(0)
+#define   NFC_STATUS_READY		BIT(2)
+#define NFC_INT_EN			0x24
+#define NFC_INT_ST			0x28
+#define   NFC_INT_ND_DONE		BIT(0)
+#define   NFC_INT_TX_BUF_RDY		BIT(1)
+#define   NFC_INT_RX_BUF_RDY		BIT(2)
+#define   NFC_INT_ECC_ERR		BIT(3)
+#define   NFC_INT_ALL			GENMASK(7, 0)
+#define NFC_CONF1			0x2c
+#define   NFC_CONF1_PAGE_2K		BIT(0)
+#define   NFC_CONF1_ECC_POS_M		GENMASK(19, 8)
+#define   NFC_CONF1_ECC_POS0_S		8
+#define   NFC_CONF1_ECC_POS1_S		12
+#define   NFC_CONF1_ECC_POS2_S		16
+#define NFC_ECC_P1			0x30
+#define   NFC_ECC(s)			(NFC_ECC_P1 + (s) * 4)
+#define NFC_ECC_ERR1			0x40
+#define NFC_ADDR2			0x50
+
+#define NFC_NO_CMD			-1
+
+/*
+ * Operation configuration words.
+ *
+ * Bits 3 and 2 enable the ECC engine and the (unused) GDMA engine, bits
+ * 19:16 hold the number of address cycles and bits 31:20 the number of data
+ * bytes.  The remaining low bits select the command sequence driven onto
+ * the NAND bus (which of CMD1/CMD2/CMD3 are used, whether the sequencer
+ * waits for the device to become ready and so on).  That encoding is not
+ * documented anywhere; the values below are the ones used by the vendor
+ * driver and must not be changed, otherwise the sequencer silently drives
+ * an invalid bus protocol.
+ */
+#define NFC_CONF_OP_STATUS		0x000101	/* one command */
+#define NFC_CONF_OP_READ_512		0x000141	/* READ0/READOOB */
+#define NFC_CONF_OP_READ_2K		0x000511	/* READ0 + READSTART */
+#define NFC_CONF_OP_WRITE_2K		0x001123	/* SEQIN + PAGEPROG */
+#define NFC_CONF_OP_WRITE_512		0x001223	/* SEQIN + PAGEPROG */
+#define NFC_CONF_OP_WRITE		0x000103	/* one command, data out */
+#define NFC_CONF_OP_RESET		0x000411	/* CMD1 = 0, CMD2 = 0xff */
+
+#define MT7620_NFC_NAME			"mt7620-nand"
+
+/* Legacy layout: 512 byte ECC sectors, three parity bytes each */
+#define MT7620_ECC_SECTOR_SIZE		512
+#define MT7620_ECC_BYTES		3
+#define MT7620_OOB_2K_STRIDE		16
+#define MT7620_OOB_2K_ECC_OFFSET	6
+#define MT7620_OOB_512_ECC_OFFSET	5
+
+#define MT7620_NFC_TIMEOUT_MS		1000
+#define MT7620_NFC_FIFO_RETRY		100000
+
+/* The command values used by the vendor driver for small page accesses */
+#define MT7620_NFC_CMD_SEQIN_512	0x8000
+#define MT7620_NFC_CMD_SEQIN_512_OOB	0x8050
+
+enum mt7620_nfc_dir {
+	NFC_DIR_NONE,
+	NFC_DIR_IN,
+	NFC_DIR_OUT,
+};
+
+struct mt7620_nfc {
+	struct nand_controller controller;
+	struct nand_chip nand;
+	struct device *dev;
+
+	void __iomem *regs;
+	u8 *buf;			/* writesize + oobsize scratch buffer */
+
+	bool page_2k;
+	u8 col_cycles;
+	u8 row_cycles;
+};
+
+static inline u32 nfc_read(struct mt7620_nfc *nfc, u32 reg)
+{
+	return readl(nfc->regs + reg);
+}
+
+static inline void nfc_write(struct mt7620_nfc *nfc, u32 reg, u32 val)
+{
+	writel(val, nfc->regs + reg);
+}
+
+static void nfc_clear_int(struct mt7620_nfc *nfc)
+{
+	u32 status = nfc_read(nfc, NFC_INT_ST);
+
+	if (status)
+		nfc_write(nfc, NFC_INT_ST, status);
+}
+
+static void nfc_flush_fifo(struct mt7620_nfc *nfc)
+{
+	u32 ctrl = nfc_read(nfc, NFC_CTRL);
+
+	nfc_write(nfc, NFC_CTRL, ctrl | NFC_CTRL_FLUSH);
+	nfc_write(nfc, NFC_CTRL, ctrl & ~NFC_CTRL_FLUSH);
+}
+
+static int nfc_wait_done(struct mt7620_nfc *nfc, unsigned int timeout_ms)
+{
+	unsigned long timeout = jiffies + msecs_to_jiffies(timeout_ms);
+
+	do {
+		if (nfc_read(nfc, NFC_INT_ST) & NFC_INT_ND_DONE)
+			return 0;
+		udelay(1);
+	} while (time_before(jiffies, timeout));
+
+	return -ETIMEDOUT;
+}
+
+static int nfc_wait_ready(struct mt7620_nfc *nfc, unsigned int timeout_ms)
+{
+	unsigned long timeout = jiffies + msecs_to_jiffies(timeout_ms);
+
+	do {
+		if (nfc_read(nfc, NFC_STATUS) & NFC_STATUS_READY)
+			return 0;
+		udelay(1);
+	} while (time_before(jiffies, timeout));
+
+	return -ETIMEDOUT;
+}
+
+static int nfc_wait_idle(struct mt7620_nfc *nfc)
+{
+	unsigned long timeout = jiffies + msecs_to_jiffies(MT7620_NFC_TIMEOUT_MS);
+
+	do {
+		if (!(nfc_read(nfc, NFC_STATUS) & NFC_STATUS_BUSY))
+			return 0;
+		udelay(1);
+	} while (time_before(jiffies, timeout));
+
+	return -ETIMEDOUT;
+}
+
+static int nfc_pull_data(struct mt7620_nfc *nfc, void *buf, unsigned int len)
+{
+	u8 *p = buf;
+	unsigned int retry = MT7620_NFC_FIFO_RETRY;
+
+	while (len) {
+		u32 status = nfc_read(nfc, NFC_INT_ST);
+
+		if (status & NFC_INT_RX_BUF_RDY) {
+			u32 data = nfc_read(nfc, NFC_DATA);
+			unsigned int n = min(len, 4U);
+
+			memcpy(p, &data, n);
+			p += n;
+			len -= n;
+			nfc_write(nfc, NFC_INT_ST, NFC_INT_RX_BUF_RDY);
+			retry = MT7620_NFC_FIFO_RETRY;
+		} else if (status & NFC_INT_ND_DONE) {
+			break;
+		} else {
+			if (!retry--)
+				return -ETIMEDOUT;
+			udelay(1);
+		}
+	}
+
+	return len ? -EIO : 0;
+}
+
+static int nfc_push_data(struct mt7620_nfc *nfc, const void *buf,
+			 unsigned int len)
+{
+	const u8 *p = buf;
+	unsigned int retry = MT7620_NFC_FIFO_RETRY;
+
+	while (len) {
+		u32 status = nfc_read(nfc, NFC_INT_ST);
+
+		if (status & NFC_INT_TX_BUF_RDY) {
+			u32 data = 0;
+			unsigned int n = min(len, 4U);
+
+			memcpy(&data, p, n);
+			p += n;
+			len -= n;
+			nfc_write(nfc, NFC_INT_ST, NFC_INT_TX_BUF_RDY);
+			nfc_write(nfc, NFC_DATA, data);
+			retry = MT7620_NFC_FIFO_RETRY;
+		} else if (status & NFC_INT_ND_DONE) {
+			break;
+		} else {
+			if (!retry--)
+				return -ETIMEDOUT;
+			udelay(1);
+		}
+	}
+
+	return len ? -EIO : 0;
+}
+
+/*
+ * Run one complete command sequence.
+ *
+ * @cmd1/@cmd2/@cmd3 are the command bytes, NFC_NO_CMD for an unused slot.
+ * @addr is the packed NAND address (column bytes first, then row bytes).
+ * @conf is the operation configuration word, the address cycle count and the
+ * data length are filled in here.
+ */
+static int nfc_exec(struct mt7620_nfc *nfc, u32 cmd1, int cmd2, int cmd3,
+		    u64 addr, u32 conf, void *buf, unsigned int len,
+		    enum mt7620_nfc_dir dir, unsigned int timeout_ms,
+		    bool wait_ready)
+{
+	int ret;
+
+	ret = nfc_wait_idle(nfc);
+	if (ret)
+		return ret;
+
+	nfc_clear_int(nfc);
+	nfc_flush_fifo(nfc);
+
+	nfc_write(nfc, NFC_CMD1, cmd1);
+	nfc_write(nfc, NFC_CMD2, cmd2 < 0 ? 0 : cmd2);
+	nfc_write(nfc, NFC_CMD3, cmd3 < 0 ? 0 : cmd3);
+	nfc_write(nfc, NFC_ADDR, lower_32_bits(addr));
+	nfc_write(nfc, NFC_ADDR2, upper_32_bits(addr));
+	nfc_write(nfc, NFC_CONF, conf);
+
+	switch (dir) {
+	case NFC_DIR_OUT:
+		ret = nfc_push_data(nfc, buf, len);
+		if (ret)
+			goto out;
+
+		ret = nfc_wait_done(nfc, timeout_ms);
+		break;
+	case NFC_DIR_IN:
+		ret = nfc_pull_data(nfc, buf, len);
+		if (ret)
+			goto out;
+
+		ret = nfc_wait_done(nfc, timeout_ms);
+		break;
+	default:
+		ret = nfc_wait_done(nfc, timeout_ms);
+		break;
+	}
+
+	if (ret)
+		goto out;
+
+	if (wait_ready)
+		ret = nfc_wait_ready(nfc, timeout_ms);
+
+out:
+	nfc_clear_int(nfc);
+	nfc_flush_fifo(nfc);
+
+	return ret;
+}
+
+static u32 nfc_conf(u32 op, unsigned int addr_cycles, unsigned int len,
+		    bool ecc)
+{
+	u32 conf = op;
+
+	conf |= (addr_cycles & GENMASK(3, 0)) << NFC_CONF_ADDR_CYCLES_S;
+	conf |= (len & GENMASK(11, 0)) << NFC_CONF_LEN_S;
+	if (ecc)
+		conf |= NFC_CONF_ECC;
+
+	return conf;
+}
+
+static u64 nfc_page_addr(struct mt7620_nfc *nfc, unsigned int page,
+			 unsigned int column)
+{
+	return (u64)column | ((u64)page << (nfc->col_cycles * 8));
+}
+
+static int mt7620_nfc_check_status(struct mt7620_nfc *nfc)
+{
+	u8 status = 0;
+	int ret;
+
+	ret = nfc_exec(nfc, NAND_CMD_STATUS, NFC_NO_CMD, NFC_NO_CMD, 0,
+		       nfc_conf(NFC_CONF_OP_STATUS, 0, 1, false), &status, 1,
+		       NFC_DIR_IN, MT7620_NFC_TIMEOUT_MS, false);
+	if (ret)
+		return ret;
+
+	if (status & NAND_STATUS_FAIL) {
+		dev_err(nfc->dev, "NAND operation failed (status 0x%02x)\n",
+			status);
+		return -EIO;
+	}
+
+	return 0;
+}
+
+static int mt7620_nfc_read_page_once(struct mt7620_nfc *nfc,
+				     unsigned int page, void *buf, bool ecc)
+{
+	struct mtd_info *mtd = nand_to_mtd(&nfc->nand);
+	unsigned int len = mtd->writesize + mtd->oobsize;
+	unsigned int cycles = nfc->col_cycles + nfc->row_cycles;
+	u32 op = nfc->page_2k ? NFC_CONF_OP_READ_2K : NFC_CONF_OP_READ_512;
+	u64 addr = nfc_page_addr(nfc, page, 0);
+
+	return nfc_exec(nfc, NAND_CMD_READ0,
+			nfc->page_2k ? NAND_CMD_READSTART : NFC_NO_CMD,
+			NFC_NO_CMD, addr, nfc_conf(op, cycles, len, ecc),
+			buf, len, NFC_DIR_IN, MT7620_NFC_TIMEOUT_MS, true);
+}
+
+static int mt7620_nfc_write_page_once(struct mt7620_nfc *nfc,
+				      unsigned int page, const void *buf,
+				      bool ecc)
+{
+	struct mtd_info *mtd = nand_to_mtd(&nfc->nand);
+	unsigned int len = mtd->writesize + mtd->oobsize;
+	unsigned int cycles = nfc->col_cycles + nfc->row_cycles;
+	u32 op = nfc->page_2k ? NFC_CONF_OP_WRITE_2K : NFC_CONF_OP_WRITE_512;
+	u32 cmd1 = nfc->page_2k ? NAND_CMD_SEQIN :
+				  MT7620_NFC_CMD_SEQIN_512;
+	u64 addr = nfc_page_addr(nfc, page, 0);
+	int ret;
+
+	ret = nfc_exec(nfc, cmd1, NFC_NO_CMD, NAND_CMD_PAGEPROG, addr,
+		       nfc_conf(op, cycles, len, ecc), (void *)buf, len,
+		       NFC_DIR_OUT, MT7620_NFC_TIMEOUT_MS, true);
+	if (ret)
+		return ret;
+
+	return mt7620_nfc_check_status(nfc);
+}
+
+static int mt7620_nfc_read_oob_once(struct mt7620_nfc *nfc,
+				    unsigned int page, unsigned int offs,
+				    void *buf, unsigned int len)
+{
+	struct mtd_info *mtd = nand_to_mtd(&nfc->nand);
+	unsigned int cycles;
+	u32 op;
+	u64 addr;
+
+	if (nfc->page_2k) {
+		addr = nfc_page_addr(nfc, page, mtd->writesize + offs);
+		cycles = nfc->col_cycles + nfc->row_cycles;
+		op = NFC_CONF_OP_READ_2K;
+		return nfc_exec(nfc, NAND_CMD_READ0, NAND_CMD_READSTART,
+				NFC_NO_CMD, addr,
+				nfc_conf(op, cycles, len, false), buf, len,
+				NFC_DIR_IN, MT7620_NFC_TIMEOUT_MS, true);
+	}
+
+	addr = nfc_page_addr(nfc, page, offs & 0xff);
+	cycles = 1 + nfc->row_cycles;
+	op = NFC_CONF_OP_READ_512;
+
+	return nfc_exec(nfc, NAND_CMD_READOOB, NFC_NO_CMD, NFC_NO_CMD, addr,
+			nfc_conf(op, cycles, len, false), buf, len,
+			NFC_DIR_IN, MT7620_NFC_TIMEOUT_MS, true);
+}
+
+/*
+ * Program the spare area of a page without touching the data area.
+ *
+ * The controller cannot write an arbitrary range of the OOB area, so the
+ * caller always passes the complete spare area.  The address is not used for
+ * the 2K layout because programming starts at the first spare byte.
+ */
+static int mt7620_nfc_write_oob_once(struct mt7620_nfc *nfc,
+				     unsigned int page, const void *buf,
+				     unsigned int len)
+{
+	struct mtd_info *mtd = nand_to_mtd(&nfc->nand);
+	unsigned int cycles, column;
+	u32 op, cmd1;
+	int ret;
+
+	if (nfc->page_2k) {
+		column = mtd->writesize;
+		cycles = nfc->col_cycles + nfc->row_cycles;
+		op = NFC_CONF_OP_WRITE_2K;
+		cmd1 = NAND_CMD_SEQIN;
+	} else {
+		column = 0;
+		cycles = 1 + nfc->row_cycles;
+		op = NFC_CONF_OP_WRITE_512;
+		cmd1 = MT7620_NFC_CMD_SEQIN_512_OOB;
+	}
+
+	ret = nfc_exec(nfc, cmd1, NFC_NO_CMD, NAND_CMD_PAGEPROG,
+		       nfc_page_addr(nfc, page, column),
+		       nfc_conf(op, cycles, len, false), (void *)buf, len,
+		       NFC_DIR_OUT, MT7620_NFC_TIMEOUT_MS, true);
+	if (ret)
+		return ret;
+
+	return mt7620_nfc_check_status(nfc);
+}
+
+/*
+ * Single bit error location.
+ *
+ * The ECC engine produces three parity bytes per sector.  XORing the parity
+ * read from the OOB with the parity just computed by the engine yields nine
+ * two bit crumbs holding the byte position and three crumbs holding the bit
+ * position, provided the three stored and the three computed bytes are valid
+ * BCH parity values.
+ */
+static bool mt7620_nfc_ecc_nibble_valid(u8 nibble)
+{
+	switch (nibble) {
+	case 0x0:
+	case 0x3:
+	case 0x5:
+	case 0x6:
+	case 0x9:
+	case 0xa:
+	case 0xc:
+	case 0xf:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static int mt7620_nfc_ecc_locate(const u8 *stored, const u8 *calc,
+				 int *byte, int *bit)
+{
+	u32 a, b, diff;
+	int i;
+
+	for (i = 0; i < MT7620_ECC_BYTES; i++) {
+		if (!mt7620_nfc_ecc_nibble_valid(stored[i] & 0xf) ||
+		    !mt7620_nfc_ecc_nibble_valid(stored[i] >> 4) ||
+		    !mt7620_nfc_ecc_nibble_valid(calc[i] & 0xf) ||
+		    !mt7620_nfc_ecc_nibble_valid(calc[i] >> 4))
+			return -1;
+	}
+
+	a = stored[0] | stored[1] << 8 | stored[2] << 16;
+	b = calc[0] | calc[1] << 8 | calc[2] << 16;
+	diff = a ^ b;
+
+	*byte = 0;
+	for (i = 0; i < 9; i++) {
+		u32 crumb = (diff >> (2 * i)) & 0x3;
+
+		if (crumb == 0x0 || crumb == 0x3)
+			return -1;
+		if (crumb == 0x2)
+			*byte |= 1 << i;
+	}
+
+	*bit = 0;
+	for (i = 0; i < 3; i++) {
+		u32 crumb = (diff >> (18 + 2 * i)) & 0x3;
+
+		if (crumb == 0x0 || crumb == 0x3)
+			return -1;
+		if (crumb == 0x2)
+			*bit |= 1 << i;
+	}
+
+	return 0;
+}
+
+/*
+ * Compare the parity computed by the ECC engine with the parity stored in
+ * the OOB area and fix up single bit flips.
+ *
+ * Returns the number of corrected bits or -EBADMSG.
+ */
+static int mt7620_nfc_ecc_check(struct mt7620_nfc *nfc, u8 *data,
+				const u8 *oob)
+{
+	struct mtd_info *mtd = nand_to_mtd(&nfc->nand);
+	unsigned int steps = mtd->writesize / MT7620_ECC_SECTOR_SIZE;
+	unsigned int ecc_off = nfc->page_2k ? MT7620_OOB_2K_ECC_OFFSET :
+					      MT7620_OOB_512_ECC_OFFSET;
+	unsigned int stride = nfc->page_2k ? MT7620_OOB_2K_STRIDE :
+					     MT7620_ECC_BYTES;
+	int sector, bitflips = 0;
+
+	for (sector = 0; sector < steps; sector++) {
+		const u8 *stored = oob + ecc_off + sector * stride;
+		u32 parity = nfc_read(nfc, NFC_ECC(sector));
+		u8 calc[MT7620_ECC_BYTES];
+		int byte, bit;
+
+		calc[0] = parity & 0xff;
+		calc[1] = (parity >> 8) & 0xff;
+		calc[2] = (parity >> 16) & 0xff;
+
+		/* Nothing was written to this page yet */
+		if (parity == 0)
+			continue;
+		if (stored[0] == 0xff && stored[1] == 0xff &&
+		    stored[2] == 0xff)
+			continue;
+
+		if (!memcmp(stored, calc, MT7620_ECC_BYTES))
+			continue;
+
+		if (mt7620_nfc_ecc_locate(stored, calc, &byte, &bit)) {
+			dev_dbg(nfc->dev, "uncorrectable ECC error, sector %d\n",
+				sector);
+			mtd->ecc_stats.failed++;
+			return -EBADMSG;
+		}
+
+		data[sector * MT7620_ECC_SECTOR_SIZE + byte] ^= BIT(bit);
+		bitflips++;
+		mtd->ecc_stats.corrected++;
+	}
+
+	return bitflips;
+}
+
+static int mt7620_nfc_read_page(struct nand_chip *nand, u8 *buf,
+				int oob_required, int page)
+{
+	struct mt7620_nfc *nfc = nand_get_controller_data(nand);
+	struct mtd_info *mtd = nand_to_mtd(nand);
+	int ret;
+
+	ret = mt7620_nfc_read_page_once(nfc, page, nfc->buf, true);
+	if (ret)
+		return ret;
+
+	memcpy(buf, nfc->buf, mtd->writesize);
+
+	ret = mt7620_nfc_ecc_check(nfc, buf, nfc->buf + mtd->writesize);
+	if (ret < 0)
+		return ret;
+
+	if (oob_required)
+		memcpy(nand->oob_poi, nfc->buf + mtd->writesize,
+		       mtd->oobsize);
+
+	return ret;
+}
+
+static int mt7620_nfc_read_page_raw(struct nand_chip *nand, u8 *buf,
+				    int oob_required, int page)
+{
+	struct mt7620_nfc *nfc = nand_get_controller_data(nand);
+	struct mtd_info *mtd = nand_to_mtd(nand);
+	int ret;
+
+	ret = mt7620_nfc_read_page_once(nfc, page, nfc->buf, false);
+	if (ret)
+		return ret;
+
+	memcpy(buf, nfc->buf, mtd->writesize);
+
+	if (oob_required)
+		memcpy(nand->oob_poi, nfc->buf + mtd->writesize,
+		       mtd->oobsize);
+
+	return 0;
+}
+
+static int mt7620_nfc_write_page(struct nand_chip *nand, const u8 *buf,
+				 int oob_required, int page)
+{
+	struct mt7620_nfc *nfc = nand_get_controller_data(nand);
+	struct mtd_info *mtd = nand_to_mtd(nand);
+
+	memcpy(nfc->buf, buf, mtd->writesize);
+	memcpy(nfc->buf + mtd->writesize, nand->oob_poi, mtd->oobsize);
+
+	return mt7620_nfc_write_page_once(nfc, page, nfc->buf, true);
+}
+
+static int mt7620_nfc_write_page_raw(struct nand_chip *nand, const u8 *buf,
+				     int oob_required, int page)
+{
+	struct mt7620_nfc *nfc = nand_get_controller_data(nand);
+	struct mtd_info *mtd = nand_to_mtd(nand);
+
+	memcpy(nfc->buf, buf, mtd->writesize);
+	memcpy(nfc->buf + mtd->writesize, nand->oob_poi, mtd->oobsize);
+
+	return mt7620_nfc_write_page_once(nfc, page, nfc->buf, false);
+}
+
+static int mt7620_nfc_read_oob(struct nand_chip *nand, int page)
+{
+	struct mt7620_nfc *nfc = nand_get_controller_data(nand);
+	struct mtd_info *mtd = nand_to_mtd(nand);
+
+	return mt7620_nfc_read_oob_once(nfc, page, 0, nand->oob_poi,
+					mtd->oobsize);
+}
+
+/*
+ * Writing the OOB area only programs the spare bytes, the page data and its
+ * ECC bytes are left untouched.  This is what the NAND core expects: the
+ * caller provides the complete spare area, the hardware keeps the data.
+ */
+static int mt7620_nfc_write_oob(struct nand_chip *nand, int page)
+{
+	struct mt7620_nfc *nfc = nand_get_controller_data(nand);
+	struct mtd_info *mtd = nand_to_mtd(nand);
+
+	return mt7620_nfc_write_oob_once(nfc, page, nand->oob_poi,
+					 mtd->oobsize);
+}
+
+static int mt7620_nfc_write_oob_raw(struct nand_chip *nand, int page)
+{
+	return mt7620_nfc_write_oob(nand, page);
+}
+
+static int mt7620_nfc_ooblayout_ecc(struct mtd_info *mtd, int section,
+				    struct mtd_oob_region *region)
+{
+	if (section < 0 || section >= mtd->writesize / MT7620_ECC_SECTOR_SIZE)
+		return -ERANGE;
+
+	if (mtd->writesize > MT7620_ECC_SECTOR_SIZE) {
+		region->offset = MT7620_OOB_2K_ECC_OFFSET +
+				 section * MT7620_OOB_2K_STRIDE;
+	} else {
+		region->offset = MT7620_OOB_512_ECC_OFFSET;
+	}
+	region->length = MT7620_ECC_BYTES;
+
+	return 0;
+}
+
+static int mt7620_nfc_ooblayout_free(struct mtd_info *mtd, int section,
+				     struct mtd_oob_region *region)
+{
+	if (mtd->writesize > MT7620_ECC_SECTOR_SIZE) {
+		unsigned int sectors = mtd->writesize /
+				       MT7620_ECC_SECTOR_SIZE;
+		unsigned int sector;
+
+		/*
+		 * Each 512 byte sector owns a MT7620_OOB_2K_STRIDE byte slice
+		 * of the spare area: three ECC bytes at offset 6 of the slice,
+		 * the rest is usable.  Byte 0 holds the bad block marker, so
+		 * the first slice only yields bytes 1..5.
+		 */
+		if (section < 2 * sectors) {
+			sector = section / 2;
+
+			if (!(section % 2)) {
+				region->offset = sector ?
+						 sector * MT7620_OOB_2K_STRIDE :
+						 1;
+				region->length = sector ?
+						 MT7620_OOB_2K_ECC_OFFSET :
+						 MT7620_OOB_2K_ECC_OFFSET - 1;
+			} else {
+				region->offset = sector * MT7620_OOB_2K_STRIDE +
+						 MT7620_OOB_2K_ECC_OFFSET +
+						 MT7620_ECC_BYTES;
+				region->length = MT7620_OOB_2K_STRIDE -
+						 MT7620_OOB_2K_ECC_OFFSET -
+						 MT7620_ECC_BYTES;
+			}
+
+			return 0;
+		}
+
+		if (section == 2 * sectors &&
+		    mtd->oobsize > sectors * MT7620_OOB_2K_STRIDE) {
+			region->offset = sectors * MT7620_OOB_2K_STRIDE;
+			region->length = mtd->oobsize - region->offset;
+			return 0;
+		}
+
+		return -ERANGE;
+	}
+
+	switch (section) {
+	case 0:
+		/* Bytes 0..3, the bad block marker lives at offset 4 */
+		region->offset = 0;
+		region->length = MT7620_OOB_512_ECC_OFFSET - 1;
+		return 0;
+	case 1:
+		region->offset = MT7620_OOB_512_ECC_OFFSET +
+				 MT7620_ECC_BYTES;
+		region->length = mtd->oobsize - region->offset;
+		if (!region->length)
+			return -ERANGE;
+		return 0;
+	default:
+		return -ERANGE;
+	}
+}
+
+static const struct mtd_ooblayout_ops mt7620_nfc_ooblayout_ops = {
+	.ecc = mt7620_nfc_ooblayout_ecc,
+	.free = mt7620_nfc_ooblayout_free,
+};
+
+static int mt7620_nfc_attach_chip(struct nand_chip *nand)
+{
+	struct mt7620_nfc *nfc = nand_get_controller_data(nand);
+	struct mtd_info *mtd = nand_to_mtd(nand);
+	u32 conf1;
+	u8 ecc_base;
+
+	if (mtd->writesize == 2048) {
+		nfc->page_2k = true;
+		nfc->col_cycles = 2;
+		nand->badblockpos = 0;
+	} else if (mtd->writesize == 512) {
+		nfc->page_2k = false;
+		nfc->col_cycles = 1;
+		nand->badblockpos = 4;
+	} else {
+		dev_err(nfc->dev, "unsupported page size %u\n",
+			mtd->writesize);
+		return -EINVAL;
+	}
+
+	if (mtd->oobsize < (nfc->page_2k ? 64 : 16)) {
+		dev_err(nfc->dev, "unsupported OOB size %u\n", mtd->oobsize);
+		return -EINVAL;
+	}
+
+	nfc->row_cycles = (nand->options & NAND_ROW_ADDR_3) ? 3 : 2;
+
+	nand->ecc.engine_type = NAND_ECC_ENGINE_TYPE_ON_HOST;
+	nand->ecc.placement = NAND_ECC_PLACEMENT_OOB;
+	nand->ecc.size = MT7620_ECC_SECTOR_SIZE;
+	nand->ecc.steps = mtd->writesize / MT7620_ECC_SECTOR_SIZE;
+	nand->ecc.strength = 1;
+	nand->ecc.bytes = MT7620_ECC_BYTES;
+
+	nfc->buf = devm_kzalloc(nfc->dev, mtd->writesize + mtd->oobsize,
+				GFP_KERNEL);
+	if (!nfc->buf)
+		return -ENOMEM;
+
+	/*
+	 * Program the page size mode and the OOB offsets the hardware ECC
+	 * engine writes the parity bytes to.
+	 */
+	ecc_base = nfc->page_2k ? MT7620_OOB_2K_ECC_OFFSET :
+				  MT7620_OOB_512_ECC_OFFSET;
+
+	conf1 = nfc_read(nfc, NFC_CONF1);
+	conf1 &= ~(NFC_CONF1_ECC_POS_M | NFC_CONF1_PAGE_2K);
+	if (nfc->page_2k)
+		conf1 |= NFC_CONF1_PAGE_2K;
+	conf1 |= (u32)ecc_base << NFC_CONF1_ECC_POS0_S;
+	conf1 |= (u32)(ecc_base + 1) << NFC_CONF1_ECC_POS1_S;
+	conf1 |= (u32)(ecc_base + 2) << NFC_CONF1_ECC_POS2_S;
+	nfc_write(nfc, NFC_CONF1, conf1);
+
+	return 0;
+}
+
+static int mt7620_nfc_exec_op(struct nand_chip *nand,
+			      const struct nand_operation *op, bool check_only)
+{
+	struct mt7620_nfc *nfc = nand_get_controller_data(nand);
+	const struct nand_op_instr *instr;
+	unsigned int naddrs = 0, len = 0, timeout = MT7620_NFC_TIMEOUT_MS;
+	struct mtd_info *mtd = nand_to_mtd(nand);
+	const void *out = NULL;
+	void *in = NULL;
+	u8 cmds[3];
+	unsigned int ncmds = 0;
+	bool wait_ready = false;
+	u64 addr = 0;
+	u32 op_conf;
+	unsigned int i, j;
+
+	if (check_only)
+		return 0;
+
+	for (i = 0; i < op->ninstrs; i++) {
+		instr = &op->instrs[i];
+
+		switch (instr->type) {
+		case NAND_OP_CMD_INSTR:
+			if (ncmds == ARRAY_SIZE(cmds))
+				return -EOPNOTSUPP;
+			cmds[ncmds++] = instr->ctx.cmd.opcode;
+			break;
+		case NAND_OP_ADDR_INSTR:
+			if (naddrs + instr->ctx.addr.naddrs > 8)
+				return -EOPNOTSUPP;
+			for (j = 0; j < instr->ctx.addr.naddrs; j++) {
+				addr |= (u64)instr->ctx.addr.addrs[j] <<
+					(8 * naddrs);
+				naddrs++;
+			}
+			break;
+		case NAND_OP_DATA_IN_INSTR:
+			in = instr->ctx.data.buf.in;
+			len = instr->ctx.data.len;
+			break;
+		case NAND_OP_DATA_OUT_INSTR:
+			out = instr->ctx.data.buf.out;
+			len = instr->ctx.data.len;
+			break;
+		case NAND_OP_WAITRDY_INSTR:
+			wait_ready = true;
+			timeout = instr->ctx.waitrdy.timeout_ms;
+			break;
+		default:
+			return -EOPNOTSUPP;
+		}
+	}
+
+	/*
+	 * A bare WAIT_RDY operation only polls the R/B# line.  The core emits
+	 * one after each page read for chips carrying NAND_NEED_READRDY;
+	 * without this the wait would fail and trigger a warning.
+	 */
+	if (!ncmds) {
+		if (!wait_ready)
+			return -EOPNOTSUPP;
+		return nfc_wait_ready(nfc, timeout);
+	}
+
+	/* The sequencer has no CHange Read/Write Column mode */
+	if (cmds[0] == NAND_CMD_RNDOUT || cmds[0] == NAND_CMD_RNDIN)
+		return -EOPNOTSUPP;
+
+	if (ncmds == 1 && cmds[0] == NAND_CMD_RESET) {
+		/* Chip reset: no command in CMD1, 0xff in CMD2 */
+		if (nfc_wait_idle(nfc))
+			return -ETIMEDOUT;
+
+		nfc_clear_int(nfc);
+		nfc_flush_fifo(nfc);
+		nfc_write(nfc, NFC_CMD1, 0);
+		nfc_write(nfc, NFC_CMD2, NAND_CMD_RESET);
+		nfc_write(nfc, NFC_CMD3, 0);
+		nfc_write(nfc, NFC_ADDR, 0);
+		nfc_write(nfc, NFC_ADDR2, 0);
+		nfc_write(nfc, NFC_CONF, nfc_conf(NFC_CONF_OP_RESET, 0, 0,
+						  false));
+
+		if (nfc_wait_done(nfc, timeout) ||
+		    nfc_wait_ready(nfc, timeout)) {
+			dev_err(nfc->dev, "chip reset timed out\n");
+			return -ETIMEDOUT;
+		}
+
+		nfc_clear_int(nfc);
+		nfc_flush_fifo(nfc);
+
+		return 0;
+	}
+
+	/*
+	 * READ PARAMETER PAGE: one command, one address cycle, then the chip
+	 * needs tR before the data is clocked out.
+	 */
+	if (ncmds == 1 && cmds[0] == NAND_CMD_PARAM) {
+		return nfc_exec(nfc, cmds[0], NFC_NO_CMD, NFC_NO_CMD, addr,
+				nfc_conf(NFC_CONF_OP_READ_512, naddrs, len,
+					 false), in, len, NFC_DIR_IN, timeout,
+				wait_ready);
+	}
+
+	if (ncmds == 2 && cmds[0] == NAND_CMD_ERASE1) {
+		/* ERASE1 + row address + ERASE2, then R/B polling */
+		op_conf = NFC_CONF_OP_READ_2K;
+		return nfc_exec(nfc, cmds[0], cmds[1], NFC_NO_CMD, addr,
+				nfc_conf(op_conf, naddrs, 0, false), NULL, 0,
+				NFC_DIR_NONE, timeout, true);
+	}
+
+	if (ncmds == 2 && cmds[0] == NAND_CMD_READ0 &&
+	    cmds[1] == NAND_CMD_READSTART) {
+		op_conf = nfc->page_2k ? NFC_CONF_OP_READ_2K :
+					 NFC_CONF_OP_READ_512;
+		return nfc_exec(nfc, cmds[0],
+				nfc->page_2k ? cmds[1] : NFC_NO_CMD,
+				NFC_NO_CMD, addr,
+				nfc_conf(op_conf, naddrs, len, false), in, len,
+				NFC_DIR_IN, timeout, wait_ready);
+	}
+
+	if (ncmds == 2 && cmds[0] == NAND_CMD_SEQIN &&
+	    cmds[1] == NAND_CMD_PAGEPROG) {
+		op_conf = nfc->page_2k ? NFC_CONF_OP_WRITE_2K :
+					 NFC_CONF_OP_WRITE_512;
+		return nfc_exec(nfc, nfc->page_2k ? cmds[0] :
+				MT7620_NFC_CMD_SEQIN_512,
+				NFC_NO_CMD, cmds[1], addr,
+				nfc_conf(op_conf, naddrs, len, false), (void *)out,
+				len, NFC_DIR_OUT, timeout, wait_ready);
+	}
+
+	if (ncmds == 3 && cmds[2] == NAND_CMD_PAGEPROG) {
+		/* PROG PAGE split in SEQIN + data + PAGEPROG */
+		op_conf = nfc->page_2k ? NFC_CONF_OP_WRITE_2K :
+					 NFC_CONF_OP_WRITE_512;
+		return nfc_exec(nfc, nfc->page_2k ? cmds[0] :
+				MT7620_NFC_CMD_SEQIN_512,
+				NFC_NO_CMD, cmds[2], addr,
+				nfc_conf(op_conf, naddrs, len, false), (void *)out,
+				len, NFC_DIR_OUT, timeout, wait_ready);
+	}
+
+	/* Everything else is a single command posting/reading a few bytes */
+	if (ncmds == 1 && (cmds[0] == NAND_CMD_SEQIN ||
+			   cmds[0] == NAND_CMD_PAGEPROG))
+		return -EOPNOTSUPP;
+
+	if (out)
+		op_conf = NFC_CONF_OP_WRITE;
+	else
+		op_conf = NFC_CONF_OP_STATUS;
+
+	if (len && len > mtd->writesize + mtd->oobsize)
+		return -EOPNOTSUPP;
+
+	return nfc_exec(nfc, cmds[0], ncmds > 1 ? cmds[1] : NFC_NO_CMD,
+			ncmds > 2 ? cmds[2] : NFC_NO_CMD, addr,
+			nfc_conf(op_conf, naddrs, len, false), out ? (void *)out :
+			in, len, out ? NFC_DIR_OUT : (in ? NFC_DIR_IN :
+						      NFC_DIR_NONE),
+			timeout, wait_ready);
+}
+
+static const struct nand_controller_ops mt7620_nfc_controller_ops = {
+	.attach_chip = mt7620_nfc_attach_chip,
+	.exec_op = mt7620_nfc_exec_op,
+};
+
+static void mt7620_nfc_hw_init(struct mt7620_nfc *nfc)
+{
+	u32 ctrl;
+
+	/* No interrupts, the driver polls the status bits */
+	nfc_write(nfc, NFC_INT_EN, 0);
+
+	/* Keep WP# deasserted and start with an empty data FIFO */
+	ctrl = nfc_read(nfc, NFC_CTRL);
+	nfc_write(nfc, NFC_CTRL, ctrl | NFC_CTRL_WP);
+
+	nfc_clear_int(nfc);
+	nfc_flush_fifo(nfc);
+}
+
+static int mt7620_nfc_init_chip(struct mt7620_nfc *nfc)
+{
+	struct nand_chip *nand = &nfc->nand;
+	struct mtd_info *mtd = nand_to_mtd(nand);
+	int ret;
+
+	nand->controller = &nfc->controller;
+	nand_set_controller_data(nand, nfc);
+	nand_set_flash_node(nand, nfc->dev->of_node);
+
+	nand->options |= NAND_NO_SUBPAGE_WRITE;
+
+	nand->ecc.engine_type = NAND_ECC_ENGINE_TYPE_ON_HOST;
+	nand->ecc.placement = NAND_ECC_PLACEMENT_OOB;
+	nand->ecc.read_page = mt7620_nfc_read_page;
+	nand->ecc.read_page_raw = mt7620_nfc_read_page_raw;
+	nand->ecc.write_page = mt7620_nfc_write_page;
+	nand->ecc.write_page_raw = mt7620_nfc_write_page_raw;
+	nand->ecc.read_oob = mt7620_nfc_read_oob;
+	nand->ecc.read_oob_raw = mt7620_nfc_read_oob;
+	nand->ecc.write_oob = mt7620_nfc_write_oob;
+	nand->ecc.write_oob_raw = mt7620_nfc_write_oob_raw;
+
+	mtd->dev.parent = nfc->dev;
+	mtd->name = MT7620_NFC_NAME;
+	mtd_set_ooblayout(mtd, &mt7620_nfc_ooblayout_ops);
+
+	mt7620_nfc_hw_init(nfc);
+
+	ret = nand_scan(nand, 1);
+	if (ret)
+		return ret;
+
+	mtk_bmt_attach(mtd);
+
+	ret = mtd_device_register(mtd, NULL, 0);
+	if (ret) {
+		mtk_bmt_detach(mtd);
+		nand_cleanup(nand);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int mt7620_nfc_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct mt7620_nfc *nfc;
+	int ret;
+
+	nfc = devm_kzalloc(dev, sizeof(*nfc), GFP_KERNEL);
+	if (!nfc)
+		return -ENOMEM;
+
+	nfc->dev = dev;
+	nfc->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(nfc->regs))
+		return PTR_ERR(nfc->regs);
+
+	nand_controller_init(&nfc->controller);
+	nfc->controller.ops = &mt7620_nfc_controller_ops;
+
+	platform_set_drvdata(pdev, nfc);
+
+	ret = mt7620_nfc_init_chip(nfc);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to initialize NAND chip\n");
+
+	return 0;
+}
+
+static void mt7620_nfc_remove(struct platform_device *pdev)
+{
+	struct mt7620_nfc *nfc = platform_get_drvdata(pdev);
+	struct nand_chip *nand = &nfc->nand;
+	struct mtd_info *mtd = nand_to_mtd(nand);
+
+	mtk_bmt_detach(mtd);
+	mtd_device_unregister(mtd);
+	nand_cleanup(nand);
+}
+
+static const struct of_device_id mt7620_nfc_id_table[] = {
+	{ .compatible = "mediatek,mt7620-nfc" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt7620_nfc_id_table);
+
+static struct platform_driver mt7620_nfc_driver = {
+	.probe = mt7620_nfc_probe,
+	.remove = mt7620_nfc_remove,
+	.driver = {
+		.name = MT7620_NFC_NAME,
+		.of_match_table = mt7620_nfc_id_table,
+	},
+};
+module_platform_driver(mt7620_nfc_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("OpenWrt contributors");
+MODULE_DESCRIPTION("MediaTek MT7620 NAND Flash Controller driver");
