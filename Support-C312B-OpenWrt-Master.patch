diff --git a/target/linux/ramips/patches-6.18/412-mtd-rawnand-add-driver-support-for-MT7620-nand-flash.patch b/target/linux/ramips/patches-6.18/412-mtd-rawnand-add-driver-support-for-MT7620-nand-flash.patch
new file mode 100644
index 0000000..bca317a
--- /dev/null
+++ b/target/linux/ramips/patches-6.18/412-mtd-rawnand-add-driver-support-for-MT7620-nand-flash.patch
@@ -0,0 +1,43 @@
+From 5a7b9c0d1e2f3041526374859607a8b9c0d1e2f3 Mon Sep 17 00:00:00 2001
+From: OpenWrt contributors <openwrt@localhost>
+Date: Sat, 14 Nov 2026 10:00:00 +0800
+Subject: [PATCH] mtd: rawnand: add driver support for MT7620 nand flash
+ controller
+
+This patch adds a NAND flash controller driver for the MediaTek MT7620
+SoC.  The controller is a one-shot command sequencer with a 32 bit data
+FIFO and a hardware ECC engine producing three parity bytes per 512 byte
+sector.  Single bit errors are located and corrected in software, using
+the same ECC positions, OOB layout and bad block marker positions as the
+legacy Ralink driver, so images written by the vendor bootloader stay
+readable.
+
+The driver itself is shipped through target/linux/ramips/files.
+
+Signed-off-by: OpenWrt contributors <openwrt@localhost>
+---
+ drivers/mtd/nand/raw/Kconfig  |    9 +++++++++
+ drivers/mtd/nand/raw/Makefile |    1 +
+ 2 files changed, 10 insertions(+)
+
+--- a/drivers/mtd/nand/raw/Kconfig
++++ b/drivers/mtd/nand/raw/Kconfig
+@@ -314,2 +314,11 @@
++config MTD_NAND_MT7620
++	tristate "MT7620 NAND controller"
++	depends on SOC_MT7620 || COMPILE_TEST
++	depends on HAS_IOMEM
++	help
++	  Enables support for the NAND flash controller on MT7620 SoCs.
++	  This driver uses PIO mode and the controller 3 byte per 512 byte
++	  sector ECC engine; single bit errors are corrected in software.
++
+ config MTD_NAND_MTK
+ 	tristate "MTK NAND controller"
+--- a/drivers/mtd/nand/raw/Makefile
++++ b/drivers/mtd/nand/raw/Makefile
+@@ -49,3 +49,4 @@
+ obj-$(CONFIG_MTD_NAND_MTK)		+= mtk_nand.o
++obj-$(CONFIG_MTD_NAND_MT7620)		+= mt7620_nand.o
+ obj-$(CONFIG_MTD_NAND_MXIC)		+= mxic_nand.o
+ obj-$(CONFIG_MTD_NAND_TEGRA)		+= tegra_nand.o
-- 
